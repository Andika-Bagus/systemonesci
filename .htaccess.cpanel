# .htaccess khusus untuk cPanel/Shared Hosting

# Force PHP version (adjust as needed)
AddHandler application/x-httpd-ea-php82 .php

# Basic rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Prevent direct access to sensitive files
<Files ".env">
    Order allow,deny
    Deny from all
</Files>

<Files "composer.json">
    Order allow,deny
    Deny from all
</Files>